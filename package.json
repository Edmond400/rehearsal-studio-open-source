{
  "name": "rehearsal-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/prepare-rehearsal-assets.mjs && vite build",
    "check": "tsc --noEmit",
    "test": "node scripts/prepare-rehearsal-assets.mjs && node tests/rehearsal-algorithm.test.mjs && node tests/rehearsal-pptx.test.mjs && node tests/rehearsal-reading-pdf.test.mjs && node tests/rehearsal-editing.test.mjs && node tests/rehearsal-slide-cache.test.mjs && node tests/rehearsal-audio.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test:security": "node tests/studio-security.test.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/assert-independent-deploy.mjs && wrangler deploy",
    "test:transport": "node tests/transport.test.mjs",
    "test:cloud-perf": "node tests/v14-cloud-perf-smoke.mjs",
    "test:migration": "python tests/studio-migration.test.py",
    "test:creation": "node tests/creation-client.test.mjs",
    "test:deploy-guard": "node tests/deployment-guard.test.mjs",
    "test:e3": "python tests/rehearsal-protection-v14.test.py && pnpm test:security",
    "test:e2": "node tests/rehearsal-editor-v14.test.mjs && pnpm test:security",
    "test:v14": "node tests/studio-password-v14.test.mjs && node tests/rehearsal-release-v14.test.mjs && python tests/studio-migration-v14.test.py",
    "test:release-preflight": "pnpm check && pnpm test && pnpm test:security && pnpm test:transport && pnpm test:creation && pnpm test:migration && pnpm test:deploy-guard && pnpm test:v14 && pnpm test:e3 && node tests/studio-large-files-v14.test.mjs && pnpm build && pnpm --dir mobile build",
    "test:v15": "node tests/rehearsal-import-v15.test.mjs && node tests/rehearsal-editing-v15.test.mjs && node tests/rehearsal-members-v15.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@web-ppt/core": "0.5.0-beta.7",
    "fflate": "0.8.2",
    "mammoth": "1.11.0",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edmond400/rehearsal-studio-open-source.git"
  }
}
