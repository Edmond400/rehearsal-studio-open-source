{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rehearsal-studio",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 19 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rehearsal-studio",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STUDIO_MEDIA",
      "bucket_name": "rehearsal-studio-media"
    }
  ],
  "vars": {
    "NATIVE_APP_ORIGIN": "https://localhost",
    "STUDIO_OPS_TELEMETRY": "1",
    "STUDIO_R2_READS": "on"
  }
}
